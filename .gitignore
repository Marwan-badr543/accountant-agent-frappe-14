.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version.
#   For an executable, it's not recommended.
#.python-version

# pipenv
#   According to pypa/pipenv#1053, Checkfile should be committed and Pipfile.lock prevent replacements.
#   Pipfile.lock is ignore-by-default because versioning tools might need it.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is ignore-by-default.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is ignore-by-default.
#.pdm-plugins/
#.pdm-python
#.pdm-build/

# PEP 582; used by e.g. github.com/lincolnloop/layman and pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

